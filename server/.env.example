# Server（端口避开画师库的 3001/5174）
# SERVER_HOST：仅本机使用填 127.0.0.1（不暴露到局域网）；
# 需局域网/公网访问时填 0.0.0.0，但务必前置反向代理 + 防火墙白名单，勿裸奔公网。
SERVER_HOST=127.0.0.1
SERVER_PORT=3002

# MySQL Database（本机已有 MySQL 8；库名独立于画师库）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=sourcing_radar

# 允许跨域访问的前端源（逗号分隔），不配置则使用内置开发默认值
# 允许跨域访问的前端源（逗号分隔）。生产务必显式配置为真实域名，不要依赖内置的 localhost 兜底。
# CORS_ORIGINS=http://localhost:5175,http://localhost:3002

# JWT（登录鉴权密钥，必填；生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"）
# 安全：此密钥泄露可离线伪造任意用户 token，务必保密；疑似泄露立即重新生成（会使现有登录失效）。
JWT_SECRET=

# AI 助手（全库聊天）。走 Anthropic Messages 协议的中转网关。
# 安全：AI_API_KEY 对应网关额度，泄露可被盗刷，切勿提交/外发；疑似泄露到网关后台吊销重签。
# 不配置 AI_API_KEY 时其它接口照常工作，仅 AI 功能不可用（启动会打印告警）。
AI_API_KEY=
# 中转网关地址，例如 https://your-gateway.example.com（留空则用 SDK 默认 Anthropic 官方地址）
AI_BASE_URL=
# 模型名，默认 deepseek-v4-pro
# AI_MODEL=deepseek-v4-pro
# 单次回复最大 token，默认 4000
# AI_MAX_TOKENS=4000
# 请求超时（毫秒），默认 90000
# AI_TIMEOUT_MS=90000

# 每周自动重爬（周一凌晨3点）。默认关闭，设为 true 才启用
CRAWL_WEEKLY_ENABLED=false

# 初始账号口令（db:seed-users 用）。留空则随机生成并在控制台打印一次。
# 不再硬编码弱口令；生产建议显式设置或用随机值后立即登录改密。
# SEED_ADMIN_PASSWORD=
# SEED_VIEWER_PASSWORD=
